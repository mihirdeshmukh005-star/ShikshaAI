# Copy this file to backend/.env and set your own Gemini API key.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Stable defaults compatible with current Gemini API.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Hybrid RAG: semantic embeddings are used when lexical retrieval is weak.
RAG_USE_EMBEDDINGS=true
RAG_TOP_K=6
EMBEDDING_DIM=768

FRONTEND_ORIGIN=http://localhost:5173

# Database (SQLite file). Override this in production to point at a
# persistent volume/mount instead of the repo's local data/ folder. No
# database credentials are hardcoded anywhere in source — this is the only
# place the location is configured.
DATABASE_PATH=./data/edureal.sqlite3
